# ==========================================
# Lumière Cosmetics - Production Environment Settings
# ==========================================

# Active Profile
SPRING_PROFILES_ACTIVE=prod

# PostgreSQL configuration (internal container connection)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=platform_db

SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# Redis settings (internal container connection)
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=
SPRING_DATA_REDIS_TIMEOUT=2s

# RabbitMQ settings (internal container connection)
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# JWT / Security Settings
AUTH_JWT_ISSUER=auth-service
AUTH_JWT_SECRET=NUQyuZhoBd6u6O6dAP30Rgu5bqv5TdzpKreGhZGExSaHXEQIM3kicw9uptSaJP9Q
AUTH_JWT_ACCESS_TOKEN_EXPIRATION=60m
AUTH_JWT_REFRESH_TOKEN_EXPIRATION=7d
AUTH_GOOGLE_CLIENT_ID=882085193535-rf3gueug3d0tbfmnunl9sag5765lfjtt.apps.googleusercontent.com

# Service Inter-auth Security API Keys
USER_SERVICE_INTERNAL_AUTH_HEADER_NAME=X-Internal-Api-Key
USER_SERVICE_INTERNAL_AUTH_API_KEY=pLKFZPUCbgok8atCXPhO2hxwwjiUUfh4

# Resend API Key for notification-service
RESEND_API_KEY=re_MNx4RuRX_2YNf5tNzeQcbSX2HE41eDL7k
MAIL_FROM=Lumière <noreply@quochuy9.id.vn>
FRONTEND_BASE_URL=http://localhost:5173

# Auth rate limiting, cookie, and OTP configs
AUTH_REDIS_REFRESH_TOKEN_KEY_PREFIX=refresh:
AUTH_COOKIE_REFRESH_TOKEN_NAME=refreshTokenId
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_HTTP_ONLY=true
AUTH_COOKIE_SAME_SITE=Strict
AUTH_COOKIE_PATH=/api/v1/auth
AUTH_COOKIE_DOMAIN=
AUTH_RATE_LIMIT_LOGIN_REGISTER_ENABLED=true
AUTH_RATE_LIMIT_LOGIN_REGISTER_CAPACITY=5
AUTH_RATE_LIMIT_LOGIN_REGISTER_REFILL_TOKENS=5
AUTH_RATE_LIMIT_LOGIN_REGISTER_REFILL_DURATION=1m
AUTH_RATE_LIMIT_LOGIN_REGISTER_KEY_PREFIX=auth:rate-limit:
AUTH_OTP_LENGTH=6
AUTH_OTP_TTL=5m
AUTH_OTP_FORGOT_KEY_PREFIX=otp:forgot:
AUTH_OTP_CHANGE_KEY_PREFIX=otp:change:
AUTH_VERIFY_TOKEN_TTL=24h
AUTH_VERIFY_KEY_PREFIX=verify:
AUTH_RABBITMQ_CRITICAL_EXCHANGE=critical.exchange
AUTH_RABBITMQ_NOTIFICATION_EXCHANGE=notification.exchange
AUTH_RABBITMQ_ROUTING_EMAIL_VERIFY=email.verify
AUTH_RABBITMQ_ROUTING_EMAIL_OTP=email.otp
AUTH_RABBITMQ_ROUTING_ACCOUNT_CREATED=account.created

USER_RABBITMQ_ACCOUNT_CREATED_QUEUE=user.account.created.queue
USER_RABBITMQ_ROUTING_ACCOUNT_CREATED=account.created

# Eureka configurations (unused in production by default but parsed)
EUREKA_DEFAULT_ZONE=http://localhost:8761/eureka/
EUREKA_INSTANCE_PREFER_IP_ADDRESS=true
EUREKA_INSTANCE_IP_ADDRESS=127.0.0.1
EUREKA_INSTANCE_HOSTNAME=localhost

# Verify Account Email configurations
AUTH_VERIFY_ACCOUNT_KEY_PREFIX=verify:account:

# Notification RabbitMQ exchange, routing, and queue configurations
NOTIFICATION_RABBITMQ_CRITICAL_EXCHANGE=critical.exchange
NOTIFICATION_RABBITMQ_NOTIFICATION_EXCHANGE=notification.exchange
NOTIFICATION_RABBITMQ_ROUTING_EMAIL_VERIFY=email.verify
NOTIFICATION_RABBITMQ_ROUTING_EMAIL_OTP=email.otp
NOTIFICATION_RABBITMQ_ROUTING_EMAIL_ORDER=email.order
NOTIFICATION_RABBITMQ_ROUTING_EMAIL_PAYMENT=email.payment
NOTIFICATION_RABBITMQ_QUEUE_EMAIL_VERIFY=email.verify.queue
NOTIFICATION_RABBITMQ_QUEUE_EMAIL_OTP=email.otp.queue
NOTIFICATION_RABBITMQ_QUEUE_EMAIL_ORDER=email.order.queue
NOTIFICATION_RABBITMQ_QUEUE_EMAIL_PAYMENT=email.payment.queue

# Listener Acknowledge Mode
SPRING_RABBITMQ_LISTENER_ACK_MODE=auto
